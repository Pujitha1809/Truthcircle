# ==========================================
# TruthCircle Environment Configuration
# ==========================================

# 1. Nexconn Chat SDK
# Connects to Nexconn Chat engine when set; TruthCircle also maintains an automatic
# resilient local WebSocket + BroadcastChannel sync bridge for instant offline/online multi-tab & split-screen demo.
NEXCONN_APP_ID=your_nexconn_app_id_here
NEXCONN_SECRET=your_nexconn_secret_here
VITE_NEXCONN_APP_ID=your_nexconn_app_id_here

# 2. SerpApi Multi-Engine Pipeline
# Powers Google News Consensus (engine="google_news"), Fact Check Hunter (engine="google"),
# and Deep Page Extraction (engine="extract", output="md", include_markdown=true)
SERPAPI_API_KEY=your_serpapi_api_key_here

# 3. You.com Cited Research & Search API
# Powers authoritative RAG verdict synthesis, confidence scores, and inline web citations via X-API-Key
YOU_API_KEY=your_youcom_api_key_here
YDC_API_KEY=your_youcom_api_key_here

# Server & Network Configuration
PORT=8000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
